{
  "dxt_version": "0.2",
  "name": "@plazafyi/mcp",
  "version": "0.0.2",
  "description": "The official MCP Server for the Plaza API",
  "author": {
    "name": "Plaza",
    "email": "support@plaza.fyi"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plazafyi/plaza-typescript.git"
  },
  "homepage": "https://github.com/plazafyi/plaza-typescript/tree/main/packages/mcp-server#readme",
  "documentation": "https://docs.plaza.fyi",
  "server": {
    "type": "node",
    "entry_point": "index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/index.js"
      ],
      "env": {
        "PLAZA_API_KEY": "${user_config.PLAZA_API_KEY}"
      }
    }
  },
  "user_config": {
    "PLAZA_API_KEY": {
      "title": "api_key",
      "description": "Plaza API key",
      "required": true,
      "type": "string"
    }
  },
  "tools": [],
  "tools_generated": true,
  "compatibility": {
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "keywords": [
    "api"
  ]
}
